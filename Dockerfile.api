FROM python:3.10-slim

WORKDIR /app

COPY requirements-api.txt .
RUN pip install --no-cache-dir -r requirements-api.txt

COPY movieposter_api.py .
COPY model.py .

# Installe gdown et télécharge les poids depuis Google Drive
RUN pip install --no-cache-dir gdown && \
    mkdir -p weights && \
    gdown "https://drive.google.com/uc?id=1gUjjA6Kw2DtxDWup7WHCA0_D8lST2gvQ" -O weights/movieposter_net.pth

# Pré-télécharge les poids ResNet50 au moment du build
RUN python -c "from torchvision.models import resnet50, ResNet50_Weights; resnet50(weights=ResNet50_Weights.IMAGENET1K_V2)"

EXPOSE 5075
CMD ["python", "movieposter_api.py", "--model_path", "weights/movieposter_net.pth"]